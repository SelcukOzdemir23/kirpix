---
import { copy } from '../content/copy';
import type { Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].nav;
const links = [
  { href: '#nasil', label: t.how },
  { href: '#kriterler', label: t.modes },
  { href: '#gizlilik', label: t.privacy },
  { href: '#durum', label: t.status },
];
---

<header class="sticky top-0 z-30 border-b border-line bg-ink/85 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 w-full max-w-[1180px] items-center gap-7 px-5 sm:px-8"
  >
    <a href={t.wordmarkHref} class="text-[19px] font-semibold tracking-[-0.035em]">kirpix</a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[14px] text-muted transition-colors hover:text-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={t.switchHref}
        hreflang={t.switchLang}
        class="rounded-md px-2.5 py-1.5 font-mono text-[11px] text-muted transition-colors hover:bg-surface-2 hover:text-text"
      >
        {t.switchLabel}
      </a>
      <a
        href="https://github.com/SelcukOzdemir23/kirpix"
        target="_blank"
        rel="noreferrer"
        class="rounded-md border border-line px-3 py-1.5 text-[13px] transition-colors hover:border-white/25 hover:bg-surface-2"
      >
        {t.github}
      </a>
    </div>
  </nav>
</header>
