---
import { copy } from '../content/copy';
import type { Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].why;
---

<section class="border-b border-line py-16 md:py-24">
  <div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8">
    <h2
      class="max-w-[22ch] text-[1.9rem] leading-[1.12] font-medium tracking-[-0.035em] text-balance sm:text-[2.6rem]"
    >
      {t.title}
    </h2>
    <p class="mt-5 max-w-[64ch] text-[16px] leading-relaxed text-muted">{t.body}</p>

    <dl class="mt-14 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-3">
      {
        t.points.map((point) => (
          <div class="border-t border-line pt-4">
            <dt class="text-[15px] font-medium text-accent">{point.name}</dt>
            <dd class="mt-1.5 text-[15px] leading-relaxed text-text/85">{point.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
