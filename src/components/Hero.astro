---
import ClipPanel from './ClipPanel.astro';
import { copy } from '../content/copy';
import type { Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].hero;
---

<section class="border-b border-line">
  <div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8">
    <div
      class="grid grid-cols-1 items-center gap-12 pt-14 pb-14 md:grid-cols-12 md:gap-12 md:pt-24 md:pb-24"
    >
      <div class="md:col-span-7">
        <h1
          class="rise max-w-[16ch] text-[clamp(2.3rem,5vw,3.5rem)] leading-[1.04] font-medium tracking-[-0.04em] text-balance"
        >
          {t.title}
        </h1>

        <p class="rise mt-5 max-w-[46ch] text-[16.5px] leading-relaxed text-muted" style="--i:1">
          {t.body}
        </p>

        <div class="rise mt-8 flex flex-wrap items-center gap-3" style="--i:2">
          <a
            href="https://github.com/SelcukOzdemir23/kirpix"
            target="_blank"
            rel="noreferrer"
            class="rounded-lg bg-text px-5 py-2.5 text-[14px] font-medium text-ink transition-colors hover:bg-white active:translate-y-px"
          >
            {t.primary}
          </a>
          <a
            href="#nasil"
            class="rounded-lg border border-line px-5 py-2.5 text-[14px] text-text/90 transition-colors hover:border-white/25 hover:bg-surface-2 active:translate-y-px"
          >
            {t.secondary}
          </a>
        </div>
      </div>

      <div class="rise md:col-span-5" style="--i:3">
        <ClipPanel lang={lang} />
      </div>
    </div>
  </div>
</section>
