---
import { copy } from '../content/copy';
import type { Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].status;
---

<section id="durum" class="border-b border-line py-16 md:py-24">
  <div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8">
    <h2 class="text-[1.7rem] leading-tight font-medium tracking-[-0.03em] sm:text-[2rem]">{t.title}</h2>
    <p class="mt-4 max-w-[64ch] text-[16px] leading-relaxed text-muted">{t.body}</p>

    <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <div class="font-mono text-[11px] text-accent">{t.readyLabel}</div>
        <ul class="mt-4 space-y-3">
          {t.ready.map((item) => <li class="text-[15px] leading-relaxed text-text/85">{item}</li>)}
        </ul>
      </div>

      <div>
        <div class="font-mono text-[11px] text-muted">{t.nextLabel}</div>
        <ul class="mt-4 space-y-3">
          {t.next.map((item) => <li class="text-[15px] leading-relaxed text-muted">{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
